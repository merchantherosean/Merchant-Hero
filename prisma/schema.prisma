generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id           String          @id @default(cuid())
  mid          String          @unique
  dba          String
  processor    String
  status       String          @default("Active")
  hidden       Boolean         @default(false) // Hidden from agent reports but included in company P&L
  mcc          String?
  approvalDate DateTime?
  riskLevel    String?
  residuals    Residual[]
  tags         MerchantTag[]
  agents       MerchantAgent[]
  notes        MerchantNote[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([processor])
  @@index([status])
  @@index([hidden])
}

model Agent {
  id                  String          @id @default(cuid())
  name                String          @unique
  email               String?
  phone               String?
  splitPercent        Float?
  status              String          @default("Active")
  merchantAssignments MerchantAgent[]
  tags                AgentTag[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Residual {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  processor     String
  year          Int
  month         Int
  volume        Float    @default(0)
  income        Float    @default(0)
  netCommission Float    @default(0)
  transactions  Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([merchantId, processor, year, month])
  @@index([year, month])
  @@index([processor])
}

model ResidualUpload {
  id          String   @id @default(cuid())
  processor   String
  year        Int
  month       Int
  fileName    String
  recordCount Int
  totalVolume Float
  totalNet    Float
  rawCsvUrl   String?
  uploadedAt  DateTime @default(now())

  @@unique([processor, year, month])
}

// Tags for grouping merchants
model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String        @default("#7c6aef") // Display color for the tag
  merchants MerchantTag[]
  agents    AgentTag[]
  createdAt DateTime      @default(now())
}

// Many-to-many: Merchant <-> Tag
model MerchantTag {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([merchantId, tagId])
  @@index([tagId])
}

// Many-to-many: Merchant <-> Agent (each assignment has its own BPS rate)
model MerchantAgent {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bpsRate    Float?   // Basis points rate this agent earns on this merchant
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, agentId])
  @@index([agentId])
}

// Many-to-many: Agent <-> Tag (for grouping merchants in reports)
model AgentTag {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([agentId, tagId])
  @@index([tagId])
}

model MerchantNote {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([merchantId])
}

model Lead {
  id               String   @id @default(cuid())
  businessName     String
  ownerName        String?
  email            String?
  phone            String?
  location         String?
  industry         String?
  confidenceScore  Int      @default(5)
  source           String?
  painPoints       String?
  contactMethod    String?
  followUpPriority String   @default("MEDIUM")
  notes            String?
  status           String   @default("New")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AppLink {
  id          String  @id @default(cuid())
  title       String
  url         String
  description String?
  category    String?
  sortOrder   Int     @default(0)
}

model Setting {
  key   String @id
  value String
}

model Document {
  id         String   @id @default(cuid())
  name       String
  category   String   // "contracts" | "marketing" | "training" | "legal"
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  @@index([category])
}

model SentEmail {
  id           String   @id @default(cuid())
  to           String
  cc           String?
  subject      String
  body         String
  status       String   @default("sent") // "sent" | "failed"
  errorMessage String?
  sentAt       DateTime @default(now())

  @@index([status])
  @@index([sentAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
